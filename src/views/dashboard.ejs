<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <section class="dashboard-card">
        <h2>Account Information</h2>
        <p><strong>Name:</strong> <%= name %></p>
        <p><strong>Username:</strong> <%= email %></p>
        <p><strong>Role:</strong> <%= user.role_name %></p>
    </section>

    <section class="dashboard-card">
        <h2>My Volunteer Projects</h2>

        <% if (volunteerProjects.length === 0) { %>
            <p>You have not signed up to volunteer for any projects yet.</p>
        <% } else { %>
            <ul class="volunteer-list">
                <% volunteerProjects.forEach(project => { %>
                    <li>
                        <div>
                            <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                            <span class="volunteer-meta">
                                <%= project.organization_name %> &middot; <%= project.date.toLocaleDateString() %>
                            </span>
                        </div>
                        <form action="/unvolunteer/<%= project.project_id %>" method="POST">
                            <input type="hidden" name="returnTo" value="dashboard">
                            <button type="submit" class="link-button">Remove</button>
                        </form>
                    </li>
                <% }); %>
            </ul>
        <% } %>