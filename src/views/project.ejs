<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>

    <p>Description: <%= project.description %></p>
    <p>Date: <%= project.date.toLocaleDateString() %></p>
    <p>Location: <%= project.location %></p>
    <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    <p>Categories:
        <% categories.forEach((category, i) => { %>
            <a href="/category/<%= category.category_id %>"><%= category.name %></a><% if (i < categories.length - 1) { %>, <% } %>
        <% }); %>
    </p>

        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
    <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
</main>
</main>
<%- include('partials/footer') %>